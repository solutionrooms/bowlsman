DEPLOYMENT_MODE=docker
NEXT_PUBLIC_API_URL=http://localhost:8010
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8010/ws
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
