# Example environment file for bowlsman backend
# Copy this to .env.local for local development or .env for docker/production

# Django settings
SECRET_KEY=your-secret-key-here
DEBUG=True
DEPLOYMENT_MODE=local  # local or docker

# Database settings
POSTGRES_DB=bowlsman_local
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email settings
EMAIL_MODE=console  # console or smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SSL=False
SMTP_USER=username
SMTP_PASS=password
SMTP_SENDER=noreply@example.com

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:3000

# Weather API Key (from weatherapi.com)
WEATHER_API_KEY=44da80cc66224366a6f180522250304